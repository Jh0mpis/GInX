# Parameter definitions for thorn Particles

RESTRICTED: INT particle_plot_every "Output in amrex particle format every that many iterations" STEERABLE=always
{
   0 :: "never output Plot"
   1:* :: "every that many iterations"
} 0

RESTRICTED: INT particle_tsv_every "Output in TSV format every that many iterations" STEERABLE=always
{
  0 :: "never output TSV"
  1:* :: "every that many iterations"
} 0

# Banned regions parameters

RESTRICTED: INT banned_regions "Number of banned regions." STEERABLE=always
{
    0:10 :: "Up to 10 different regions"
} 0

## Region 1
RESTRICTED: REAL region_1_position[3] "Coordinates of the region 1" STEERABLE=always
{
    *:* :: "Any value inside the Simulation domain"
} 0.0

RESTRICTED: REAL region_1_radius "" STEERABLE=always
{
    0:* :: "Any positive value"
} 0.0

