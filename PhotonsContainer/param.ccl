# Particles to create
INT num_photons "Total number of photons" {
    0:* :: ""
} 0

INT num_photons_pc "Photons per cell" {
    0:* :: ""
} 0

# Variables to use for the initialize the particles (can be used in custom codes)

KEYWORD initializer "available initializer function to be called" {
    "box" :: "Random uniform distributed particles filling the box."
    "spherical" :: "Random Spherically distributed particles."
    "none" :: "Don't use any particle initializer"
} "none"

REAL init_params_d[10] "double type parameters needed to pass to the initializer function" {
    *:* :: ""
} 0.0

REAL init_params_i[10] "int type parameters needed to pass to the initializer function" {
    *:* :: ""
} 0

# Variables to use for the initialize the metric (can be used in custom codes)

KEYWORD metric "metric to initialize" {
    "minkowski" :: "Minkowski metric"
    "iso" :: "Isotropic Schwarzswchild metric"
    "schwarzschild" :: "Schwarzswchild metric"
    "none" :: "Not initialize using a metric"
} "none" 

REAL metric_params_d[10] "double type parameters needed to pass to the metric initializer" {
    *:* :: ""
} 0.0

REAL metric_params_i[10]  "int type parameters needed to pass to the metric initializer" {
    *:* :: ""
} 0

SHARES: ParticlesContainer

USES INT particle_plot_every
USES INT particle_tsv_every

SHARES: IO

USES STRING filereader_ID_dir
USES STRING filereader_ID_files
USES STRING filereader_ID_vars

USES STRING out_dir
USES CCTK_INT out_every
USES KEYWORD out_mode
USES CCTK_INT out_proc_every

USES BOOLEAN checkpoint_ID
USES INT checkpoint_every
USES REAL checkpoint_every_walltime_hours
USES BOOLEAN checkpoint_on_terminate
USES STRING checkpoint_dir
USES STRING checkpoint_file

USES KEYWORD recover
USES STRING recover_dir
USES STRING recover_file

USES CCTK_REAL out_xline_y
USES CCTK_REAL out_xline_z
USES CCTK_REAL out_yline_x
USES CCTK_REAL out_yline_z
USES CCTK_REAL out_zline_x
USES CCTK_REAL out_zline_y
