if (CCTK_Equals(initial_metric, "minkowski")) {
    SCHEDULE init_minkowski AT CCTK_INITIAL {
        LANG: C
        OPTIONS: local
        WRITES: ADMBaseX::metric(everywhere)
        WRITES: ADMBaseX::lapse(everywhere)
        WRITES: ADMBaseX::shift(everywhere)
        WRITES: ADMBaseX::curv(everywhere)
    } "Minkowski Fields setup"
} else if (CCTK_Equals(initial_metric, "iso schwarzschild")) {
    SCHEDULE init_iso_schwarzschild AT CCTK_INITIAL {
        LANG: C
        OPTIONS: local
        WRITES: ADMBaseX::metric(everywhere)
        WRITES: ADMBaseX::lapse(everywhere)
        WRITES: ADMBaseX::shift(everywhere)
        WRITES: ADMBaseX::curv(everywhere)
    } "Fields setup"
} else if (CCTK_Equals(initial_metric, "schwarzschild")) {
    SCHEDULE init_schwarzschild AT CCTK_INITIAL {
        LANG: C
        OPTIONS: local
        WRITES: ADMBaseX::metric(everywhere)
        WRITES: ADMBaseX::lapse(everywhere)
        WRITES: ADMBaseX::shift(everywhere)
        WRITES: ADMBaseX::curv(everywhere)
    } "Fields setup"
}


SCHEDULE setup AT CCTK_POSTINITIAL after initial_metric {
    LANG: C
    OPTIONS: global
} "setup"

if ((particle_plot_every>0)||(particle_tsv_every>0) ){
    SCHEDULE print AT CCTK_POSTINITIAL AFTER setup
    {
        LANG: C
        OPTIONS: global
    } "print the particles"
}

SCHEDULE test AT evol
{
    LANG: C
    OPTIONS: global
} "testing evolution"

if ((particle_plot_every||particle_tsv_every) ) {
    SCHEDULE print AT evol AFTER test
    {
        LANG: C
        OPTIONS: global
    } "print the particles"
}

SCHEDULE PhotonsContainer_final_cleanup at CCTK_SHUTDOWN{
    LANG: C
    OPTIONS: global
} "cleaning everything"
