ActiveThorns = "
  ADMBaseX
  CarpetX
  BoxInBox
  IOUtil
  ParticlesContainer
  PhotonsContainer
  PhotonSolverUtilities
"

Cactus::presync_mode = "mixed-error"

CarpetX::verbose = yes
CarpetX::poison_undefined_values = yes

# 32 , 64  , 128  , 256   , 512    , 1024
# 2.5, 1.25, 0.625, 0.3125, 0.15625, 0.078125
$ncells  = 1024
$zlim = 0.078125

CarpetX::xmin = -10
CarpetX::ymin = -10
CarpetX::zmin = -$zlim
CarpetX::xmax = +10
CarpetX::ymax = +10
CarpetX::zmax = +$zlim


CarpetX::ncells_x = $ncells
CarpetX::ncells_y = $ncells
CarpetX::ncells_z = 8

CarpetX::periodic_x = yes
CarpetX::periodic_y = yes
CarpetX::periodic_z = yes

CarpetX::max_grid_size_x = 10000000
CarpetX::max_grid_size_y = 10000000
CarpetX::max_grid_size_z = 10000000

CarpetX::max_tile_size_x = 10000000
CarpetX::max_tile_size_y = 10000000
CarpetX::max_tile_size_z = 10000000

CarpetX::ghost_size = 3
CarpetX::dtfac = 0.5

Cactus::cctk_itlast = $ncells

#CarpetX::regrid_error_threshold = 0.9
#CarpetX::max_num_levels = 4
#
#BoxInBox::num_regions = 1
#BoxInBox::shape_1 = "cube"
#BoxInBox::num_levels_1 = 3
#BoxInBox::position_x_1 = 0.0
#BoxInBox::position_y_1 = 0.0
#BoxInBox::position_z_1 = 0.0
#BoxInBox::radius_1 = [-1, 7, 5]


#BoxInBox::shape_2 = "cube"
#BoxInBox::num_levels_2 = 2
#BoxInBox::position_x_2 = 200.0
#BoxInBox::position_y_2 = 200.0
#BoxInBox::position_z_2 = 200.0
#BoxInBox::radius_2 = [-1, 10]

IO::out_dir = $parfile
IO::out_every = 1
IO::parfile_write = no

CarpetX::out_adios2_every = 0
CarpetX::out_silo_every = 0
CarpetX::out_openpmd_every = 0

CarpetX::out_performance = no
CarpetX::out_metadata = no
CarpetX::out_tsv_vars = ""

# ParticlesContainer parameters definition
ParticlesContainer::particle_plot_every = 0
ParticlesContainer::particle_tsv_every = 1
ParticlesContainer::banned_regions = 1
ParticlesContainer::region_1_position = [0.0, 0.0, 0.0]
ParticlesContainer::region_1_radius = 3.0
ParticlesContainer::metric = "Kerr-Shild"
ParticlesContainer::metric_params_d = [0.5, 0.1]

# PhotonsContainer parameters definition
PhotonsContainer::num_photons = 2000
PhotonsContainer::init_params_d = [3.0]
