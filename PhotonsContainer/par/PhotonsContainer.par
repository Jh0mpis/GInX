ActiveThorns = "
  ADMBaseX
  CarpetX
  BoxInBox
  IOUtil
  ParticlesContainer
  PhotonsContainer
  PhotonSolverUtilities
"

Cactus::presync_mode = "mixed-error"

CarpetX::verbose = yes
CarpetX::poison_undefined_values = yes

CarpetX::xmin = -512
CarpetX::ymin = -512
CarpetX::zmin = -512
CarpetX::xmax = +512
CarpetX::ymax = +512
CarpetX::zmax = +512

CarpetX::ncells_x = 256
CarpetX::ncells_y = 256
CarpetX::ncells_z = 256

CarpetX::periodic_x = yes
CarpetX::periodic_y = yes
CarpetX::periodic_z = yes

CarpetX::max_grid_size_x = 10000000
CarpetX::max_grid_size_y = 10000000
CarpetX::max_grid_size_z = 10000000

CarpetX::max_tile_size_x = 10000000
CarpetX::max_tile_size_y = 10000000
CarpetX::max_tile_size_z = 10000000

CarpetX::ghost_size = 3
CarpetX::dtfac = 0.5

Cactus::cctk_itlast = 300

CarpetX::regrid_error_threshold = 0.9
CarpetX::max_num_levels = 6

BoxInBox::num_regions = 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = 3
BoxInBox::position_x_1 = 0.0
BoxInBox::position_y_1 = 0.0
BoxInBox::position_z_1 = 0.0
BoxInBox::radius_1 = [-1, 100.0, 20.0, 10.0, 5.0, 2.0]

IO::out_dir = $parfile
IO::out_every = 1
IO::parfile_write = no

CarpetX::out_adios2_every = 0
CarpetX::out_silo_every = 0
CarpetX::out_openpmd_every = 0

CarpetX::out_performance = no
CarpetX::out_metadata = no
CarpetX::out_tsv_vars = ""

# PhotonsContainer parameters definition
ParticlesContainer::particle_plot_every = 0
ParticlesContainer::particle_tsv_every = 0
PhotonsContainer::print_photons_constants = 0
PhotonsContainer::total_photons = 500
PhotonsContainer::initial_metric = "iso schwarzschild"
# PhotonsContainer::photons_per_cell = 5
# PhotonsContainer::initial_metric = "minkowski"
