# test.cxx switch [temporal solution]
BOOLEAN run_test "Run test.cxx file" {
} true

# Particles to create
INT num_photons "Total number of photons" {
    0:* :: ""
} 0

INT num_photons_pc "Photons per cell" {
    0:* :: ""
} 0

REAL particles_mass "Particles' mass" {
    0:* :: ""
} 0.

# Variables to use for the initialize the particles (can be used in custom codes)
KEYWORD initializer "Available initializer function to be called" {
    "box" :: "Random uniform distributed particles filling the box."
    "spherical" :: "Random Spherically distributed particles."
    "none" :: "Don't use any particle initializer"
} "none"

REAL init_params_d[10] "double parameters needed to pass to the initializer function" {
    *:* :: ""
} 0.0

REAL init_params_i[10] "int parameters needed to pass to the initializer function" {
    *:* :: ""
} 0

SHARES: BaseParticlesContainer

