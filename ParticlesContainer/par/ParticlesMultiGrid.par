ActiveThorns = "
  ADMBaseX
  CarpetX
  BoxInBox
  IOUtil
  BaseParticlesContainer
  ParticlesContainer
  ParticlesSolverUtilities
"

$nlevels = 12
$ncells  = 256
$xmin    = -8192.0
$xmax    = +8192.0
$itlast  = 256
$dtfac   = 0.5

Cactus::presync_mode = "mixed-error"

CarpetX::verbose = yes
CarpetX::poison_undefined_values = yes

CarpetX::xmin = $xmin
CarpetX::ymin = $xmin
CarpetX::zmin = $xmin
CarpetX::xmax = $xmax
CarpetX::ymax = $xmax
CarpetX::zmax = $xmax

CarpetX::ncells_x = $ncells
CarpetX::ncells_y = $ncells
CarpetX::ncells_z = $ncells

CarpetX::periodic_x = yes
CarpetX::periodic_y = yes
CarpetX::periodic_z = yes

CarpetX::max_grid_size_x = 128
CarpetX::max_grid_size_y = 128
CarpetX::max_grid_size_z = 128

CarpetX::max_tile_size_x = 1024000
CarpetX::max_tile_size_y = 1024000
CarpetX::max_tile_size_z = 1024000

CarpetX::ghost_size = 3
CarpetX::dtfac = $dtfac

Cactus::cctk_itlast = $itlast

CarpetX::max_num_levels = $nlevels
CarpetX::regrid_every = 4096  # 2^12
CarpetX::regrid_error_threshold = 0.9

BoxInBox::num_regions = 3
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = $nlevels
BoxInBox::position_x_1 = 0.0
BoxInBox::position_y_1 = 0.0
BoxInBox::radius_1 = [-1., 6., 6., 6., 6., 6., 6., 6., 6., 6., 3., 1.5]
BoxInBox::shape_2 = "cube"
BoxInBox::num_levels_2 = $nlevels
BoxInBox::position_x_2 = 6.508727e+00
BoxInBox::position_y_2 = 7.591869e+00
BoxInBox::radius_2 = [-1., 6., 6., 6., 6., 6., 6., 6., 6., 6., 3., 1.5]
BoxInBox::shape_3 = "cube"
BoxInBox::num_levels_3 = $nlevels - 2
BoxInBox::position_x_3 = 0.0
BoxInBox::radius_x_3 = [-1., 4096., 2048., 1024., 512., 256., 128., 64., 32., 20.]
BoxInBox::radius_y_3 = [-1., 4096., 2048., 1024., 512., 256., 128., 64., 32., 20.]
BoxInBox::radius_z_3 = [-1., 4096., 2048., 1024., 512., 256., 128., 64., 32., 20.]

IO::out_dir = $parfile
IO::out_every = 1
IO::parfile_write = no

CarpetX::out_adios2_every = 0
CarpetX::out_silo_every = 0
CarpetX::out_openpmd_every = 0

CarpetX::out_performance = no
CarpetX::out_metadata = no
CarpetX::out_tsv_vars = ""

# PhotonsContainer parameters definition
BaseParticlesContainer::particle_plot_every = 0
BaseParticlesContainer::particle_tsv_every = 0
ParticlesContainer::metric = "iso"
ParticlesContainer::metric_params_d = [1.0]

# BaseParticlesContainer parameters definition
BaseParticlesContainer::banned_regions = 1
BaseParticlesContainer::region_1_position = [0.0, 0.0, 0.0]
BaseParticlesContainer::region_1_radius = 0.5
BaseParticlesContainer::metric = "Isotropic Schwarzschild"
BaseParticlesContainer::metric_params_d = [1.0]

# PhotonsContainer parameters definition
ParticlesContainer::num_photons = 100000
